# Released tarballs
dist/

# Python bytecode cache (icons/build.py and friends)
__pycache__/

# VS Code (keep workspace-level config out of the repo unless intentionally shared)
.vscode/

# Claude Code Assistant
.claude/

# OS junk
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Vim editor temp
# Vim names its swap files .swp, then .swo, .swn ... down to .swa when
# more than one is open at once - and a buffer with no name of its own
# leaves the bare ".swo" this pattern also has to catch, which is how one
# got committed.
*.sw[a-p]
.*.sw[a-p]
*~

# Demo videos in MP4 format
demo/*.mp4

# helptags output: generated by the user's own :helptags, never shipped.
doc/tags
