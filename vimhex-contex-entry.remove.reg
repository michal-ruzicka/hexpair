Windows Registry Editor Version 5.00

; ===========================================================================
; vimhex-contex-entry.remove.reg - undo vimhex-contex-entry.add.reg
;
; Maintainer:  Michal Ruzicka <ruzicka.mich@gmail.com>
; URL:         https://github.com/michal-ruzicka/hexpair
; License:     Vim License - same terms as Vim itself (see LICENSE.md
;              or :help license); SPDX-License-Identifier: Vim
;
; Removes the three Explorer context-menu entries vimhex-contex-entry.add.reg
; adds - the "hexpair", "hexpair-pick" and "hexpair-with" keys, each with its
; own "command" subkey, deleted whole with the leading "-". No path to edit
; here; a key is removed by name, regardless of what its command line says.
;
; Double-click this file, or run:  reg import vimhex-contex-entry.remove.reg
; ===========================================================================

[-HKEY_CURRENT_USER\Software\Classes\*\shell\hexpair]

[-HKEY_CURRENT_USER\Software\Classes\*\shell\hexpair-pick]

[-HKEY_CURRENT_USER\Software\Classes\*\shell\hexpair-with]
